# syntax=docker/dockerfile:1.3-labs

ARG FROM_IMAGE_NAME=nvcr.io/nvidia/pytorch:26.07-py3
FROM ${FROM_IMAGE_NAME}

# Optional paired overrides; empty values preserve install.sh's training pins.
ARG NCCL_REPO_URL
ARG NCCL_REPO_SHA
ARG CUDNN_FRONTEND_REPO_URL
ARG CUDNN_FRONTEND_REPO_SHA
ARG TRANSFORMER_ENGINE_REPO_URL
ARG TRANSFORMER_ENGINE_REPO_SHA

# Keep internal dependencies enabled for production; public CI opts out explicitly.
ARG INSTALL_INTERNAL_DEPS=1

COPY dependencies/ /opt/dependencies/
RUN --mount=type=secret,id=gitlab_netrc,target=/root/.netrc \
    --mount=type=secret,id=gitlab_config,target=/root/.gitconfig \
    bash /opt/dependencies/install.sh
